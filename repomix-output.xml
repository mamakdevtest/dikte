<script>
(function(){
  document.querySelectorAll("[data-busy-demo]").forEach(b=>{
    b.addEventListener("click",()=>{
      const old=b.textContent;
      b.disabled=true;b.textContent=b.dataset.busyDemo;
      setTimeout(()=>{b.disabled=false;b.textContent=old;},900);
    });
  });
  const sess=document.getElementById("sess-min");
  const zero=document.getElementById("sess-zero");
  sess.addEventListener("change",()=>{
    zero.hidden=parseInt(sess.value,10)!==0;
  });
  document.getElementById("new-session").addEventListener("click",e=>{
    const btn=e.currentTarget;
    btn.disabled=true;
    setTimeout(()=>{
      btn.disabled=false;
      document.getElementById("sess-status").textContent="Yeni konuşma — sıradaki komut ilk komuttur.";
      const chip=btn.parentElement.querySelector(".chip");
      chip.className="chip chip-gray";
      chip.innerHTML='<span class="dot dot-idle"></span>Yeni oturum';
      DK.toast("Konuşma sıfırlandı. Claude sıradakine temiz başlar.");
    },700);
  });
})();
</script>
