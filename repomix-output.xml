    def test_the_names_a_mac_keyboard_uses(self):
        for name in ("cmd", "command", "meta", "super"):
            with self.subTest(name=name):
                self.assertEqual(hotkey.parse_macos_shortcut(f"{name}+space"),
                                 hotkey.parse_macos_shortcut("cmd+space"))
