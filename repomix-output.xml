.sound-panel{display:flex;flex-direction:column;gap:10px;padding:14px 16px;background:color-mix(in oklab,var(--sage) 11%,var(--surface));border:1px solid color-mix(in oklab,var(--sage-dark) 24%,var(--border));border-radius:8px}
.sound-panel h3{font-size:13px;font-weight:600}.sound-panel p{font-size:11.5px;line-height:17px;color:var(--fg-3)}
.sound-meter{height:58px;display:flex;align-items:center;gap:3px;padding:0 10px;background:var(--field);border:1px solid var(--border);border-radius:7px}.sound-meter i{width:4px;height:8px;border-radius:3px;background:var(--ov-rec,var(--terra));transition:height .08s ease}
.sound-controls{display:flex;align-items:center;gap:9px}.sound-controls input[type=range]{flex:1;accent-color:var(--sage-dark)}.sound-state{display:flex;align-items:center;gap:6px;min-height:18px;font-size:11px;color:var(--fg-3)}
.color-control:focus-within{outline:2px solid var(--sage-dark);outline-offset:2px}.sound-controls button:focus-visible,.sound-controls input:focus-visible{outline:2px solid var(--sage-dark);outline-offset:2px}
.ov.is-rec{--wc:var(--ov-rec,var(--terra))}.ov.is-ask{--wc:var(--ov-ask,var(--sage-dark))}.ov.is-busy{--wc:var(--ov-busy,var(--info))}
.ov-dot.rec{background:var(--ov-rec,var(--terra))}.ov-dot.ask{background:var(--ov-ask,var(--sage-dark))}.ov-dot.ok{background:var(--ov-ok,var(--ok))}.ov-dot.warn{background:var(--ov-warn,var(--warn))}.ov-dot.err{background:var(--ov-err,var(--err))}
.ov.is-ok [data-ic]{color:var(--ov-ok,var(--ok))!important}.ov.is-warn [data-ic]{color:var(--ov-warn,var(--warn))!important}.ov.is-err [data-ic]{color:var(--ov-err,var(--err))!important}.ov .arc{border-top-color:var(--ov-busy,var(--info))}
@media (max-width:900px){.overlay-tuning{grid-template-columns:1fr}.color-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:900px){.ov-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ov-cell,.ov-cell:nth-child(1),.ov-cell:nth-child(3),.ov-cell:nth-child(9){grid-column:auto}}
