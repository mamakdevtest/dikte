        self.assertEqual(run["transcribe"].call_args.kwargs["language"], "tr")
        self.assertEqual(run["transcribe"].call_args.kwargs["prompt"], "Paraşüt")

    # ---- silence and stock phrases ----------------------------------------

    def test_room_tone_costs_no_api_call(self):
