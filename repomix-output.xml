      <button class="btn btn-ink" type="button" id="reset-confirm">Evet, varsayılana dön</button>
    </div>
  </div>
</div>

<div class="scrim" id="dlg-clear-glossary" role="dialog" aria-modal="true" aria-labelledby="dlg-cg-t">
  <div class="dialog">
    <div class="dialog-h" id="dlg-cg-t"><span data-ic="trash" style="color:var(--err)"></span>Sözlük temizlensin mi?</div>
    <div class="dialog-b">
      <p>Listedeki 6 terim kaldırılır. Transkripsiyon ve temizlik artık bu isimler için ipucu almaz.</p>
    </div>
    <div class="dialog-f">
      <button class="btn btn-ghost" type="button" data-dialog-close="dlg-clear-glossary">Vazgeç</button>
      <button class="btn btn-danger solid" type="button" id="clear-confirm">Temizle</button>
    </div>
  </div>
</div>

<div class="toast-stack" aria-live="polite"></div>
<script src="assets/dikte.js"></script>
<script>
(function(){
  const DEFAULT_DICTATION=document.getElementById("ta-dictation").value;
  const DEFAULT_AUDIO=document.getElementById("ta-audio").value;
  function refresh(taId,chipId,resetBtnId,def,unit){
    const ta=document.getElementById(taId);
    const chip=document.getElementById(chipId);
    const meta=document.getElementById(metaId(taId));
    const btn=document.getElementById(resetBtnId);
    const changed=ta.value!==def;
    chip.hidden=!changed;
    chip.className="chip "+(changed?"chip-sage":"chip-gray");
    chip.innerHTML=changed?'<span class="dot dot-sage"></span>Değiştirildi':'<span class="dot dot-idle"></span>Varsayılan';
    if(btn)btn.disabled=!changed;
    const lines=ta.value?ta.value.trim().split(/\n/).length:0;
    if(meta)meta.textContent=ta.value.length.toLocaleString("tr-TR")+" karakter · "+lines+" satır";
  }
  function metaId(taId){return taId==="ta-dictation"?"meta-dictation":taId==="ta-audio"?"meta-audio":"meta-glossary";}
  ["ta-dictation","ta-audio"].forEach(id=>{
    const ta=document.getElementById(id);
    ta.addEventListener("input",()=>refresh(id,"chip-"+(id==="ta-dictation"?"dictation":"audio"),id==="ta-dictation"?"reset-dictation":"reset-audio",id==="ta-dictation"?DEFAULT_DICTATION:DEFAULT_AUDIO));
  });
  const gl=document.getElementById("ta-glossary");
  const glChip=document.getElementById("chip-glossary");
  const glMeta=document.getElementById("meta-glossary");
  const glClear=document.getElementById("clear-glossary");
  const GL_DEFAULT=gl.value;
  function glRefresh(){
    const changed=gl.value!==GL_DEFAULT;
    const empty=gl.value.trim().length===0;
    glChip.hidden=!changed&&!empty;
    glChip.className="chip "+(empty?"chip-gray":"chip-sage");
    glChip.innerHTML=empty?'<span class="dot dot-idle"></span>Boş':(changed?'<span class="dot dot-sage"></span>Değiştirildi':'');
    const lines=gl.value?gl.value.trim().split(/\n/).length:0;
    glMeta.textContent=empty?"Boş — transkripsiyon ipucu gönderilmez":lines+" satır";
    glClear.disabled=empty;
  }
  gl.addEventListener("input",glRefresh);
  glRefresh();
  document.getElementById("reset-confirm").addEventListener("click",()=>{
    const ta=document.getElementById("ta-dictation");
    ta.value=DEFAULT_DICTATION;
    refresh("ta-dictation","chip-dictation","reset-dictation",DEFAULT_DICTATION);
    DK.closeDialog("dlg-reset");
    DK.toast("Dikte talimatı varsayılana döndü.");
  });
  document.getElementById("clear-confirm").addEventListener("click",()=>{
    gl.value="";
    glRefresh();
    DK.closeDialog("dlg-clear-glossary");
    DK.toast("Sözlük temizlendi.","warn");
  });
  document.getElementById("reset-audio").addEventListener("click",()=>{
    const ta=document.getElementById("ta-audio");
    ta.value=DEFAULT_AUDIO;
    refresh("ta-audio","chip-audio","reset-audio",DEFAULT_AUDIO);
    DK.toast("Ses dosyası talimatı varsayılana döndü.");
  });
})();
</script>
</body>
</html>
</file>

