<script>
(function(){
  const LABELS={toggle:"Kaydı başlat / durdur",cancel:"Kaydı at",agent:"Ajana sor",meeting:"Toplantı başlat / bitir"};
  const combos={toggle:"Ctrl+Space",cancel:"Ctrl+Alt+Space",agent:"Ctrl+Alt+A",meeting:""};
  function renderCombo(hk,combo){
    const d=hk.querySelector(".hk-display");
    if(!combo){d.innerHTML='<span class="kbd add">yok</span><span class="hk-hint">ata</span>';hk.classList.add("empty");}
    else{
      d.innerHTML=combo.split("+").map(p=>'<span class="kbd">'+p+"</span>").join('<span class="hk-hint">+</span>');
      hk.classList.remove("empty");
    }
  }
  function statusFor(name){
    const el=document.getElementById("sc-"+name+"-status");
    if(!el)return;
    const c=combos[name];
    if(c)el.innerHTML='<span class="status-line" style="color:var(--ok)"><span class="dot dot-ok"></span>Windows\'a kayıtlı: <span class="mono">'+c+"</span></span>";
    else el.innerHTML='<span class="status-line" style="color:var(--fg-3)"><span class="dot dot-idle"></span>Kısayol yok — tepsi menüsü de yürütür.</span>';
  }
  function conflictFor(name,combo){
    if(!combo)return null;
    for(const key in combos){
      if(key!==name&&combos[key]&&combos[key]===combo)return key;
    }
    return null;
  }
  document.querySelectorAll(".hotkey[data-sc]").forEach(hk=>{
    const name=hk.dataset.sc;
    hk.addEventListener("click",()=>{
      if(hk.classList.contains("rec"))return;
      document.querySelectorAll(".hotkey.rec").forEach(o=>{
        o.classList.remove("rec");
        renderCombo(o,combos[o.dataset.sc]);
      });
      hk.classList.add("rec");
      const d=hk.querySelector(".hk-display");
      d.innerHTML='<span class="hk-hint">Tuşlara basın…</span><span class="hk-hint">Esc = vazgeç</span>';
      function onKey(ev){
        ev.preventDefault();ev.stopPropagation();
        document.removeEventListener("keydown",onKey,true);
        hk.classList.remove("rec");
        if(ev.key==="Escape"){renderCombo(hk,combos[name]);return;}
        const parts=[];
        if(ev.ctrlKey)parts.push("Ctrl");
        if(ev.altKey)parts.push("Alt");
        if(ev.shiftKey)parts.push("Shift");
        if(ev.metaKey)parts.push("Win");
        if(["Control","Alt","Shift","Meta"].includes(ev.key)){renderCombo(hk,combos[name]);return;}
        let k=ev.key===" "?"Space":(ev.key.length===1?ev.key.toUpperCase():ev.key);
        const combo=parts.concat([k]).join("+");
        const clash=conflictFor(name,combo);
        if(clash){
          renderCombo(hk,combos[name]);
          DK.toast(combo+" zaten "+LABELS[clash]+" eyleminde.","warn");
          return;
        }
        combos[name]=combo;
        renderCombo(hk,combo);
        statusFor(name);
        DK.toast("Kaydedildi: "+combo+" → "+LABELS[name]);
      }
      document.addEventListener("keydown",onKey,true);
    });
  });
  document.querySelectorAll("[data-remove-sc]").forEach(btn=>{
    btn.addEventListener("click",()=>{
      const name=btn.dataset.removeSc;
      combos[name]="";
      const hk=document.querySelector('.hotkey[data-sc="'+name+'"]');
      renderCombo(hk,"");
      statusFor(name);
      DK.toast(LABELS[name]+" kısayolu kaldırıldı.","warn");
    });
  });
})();
</script>
</body>
</html>
