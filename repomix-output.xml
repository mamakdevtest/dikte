          </div>
        </div>
        <div class="card-b">
          <div class="row" data-od-id="row-self-name">
            <div class="row-main">
              <div class="row-label">Siz</div>
              <div class="row-help">Sol kanalın satır sahibi.</div>
            </div>
            <div class="row-control" style="width:240px">
              <input class="field" value="Mamak" placeholder="Ben" aria-label="Sizin adınız">
            </div>
          </div>
