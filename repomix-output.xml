<file path="design/Dikte-Yeniden-Tasarım-Prototipi/audio-file.html">
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<title>Ses Dosyası — Dikte</title>
