    </div>
  </div>
  <aside class="sidebar" data-od-id="sidebar">
    <div class="side-brand">
      <span class="brand-badge"><img src="dikte.png" alt="" aria-hidden="true"></span>
      <div><div class="brand-name">Dikte</div><div class="brand-sub">Yerelden dikte</div></div>
    </div>
    <nav class="nav" aria-label="Bölümler">
