class FakeServer:
    """A ggml.Server as far as api.py is concerned."""

    def __init__(self, url="http://127.0.0.1:9999/v1", fails="", log=""):
        self.url = url
        self.fails = fails
        self.log = log
        self.starts = 0

    def serve(self):
        self.starts += 1
        if self.fails:
            raise ggml.LocalError(self.fails)
        return self.url

    def error(self):
        return self.log


