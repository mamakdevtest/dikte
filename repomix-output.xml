    <div class="side-foot">
      <div class="engine-card" data-od-id="engine-card">
        <div class="engine-top"><span data-ic="wave"></span><span>Whisper Small</span><span class="chip chip-sage"><span class="dot dot-sage"></span>Yerel</span></div>
