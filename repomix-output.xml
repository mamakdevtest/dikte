      row.setAttribute("role","button");
      row.tabIndex=0;
      row.innerHTML='<span class="li-ic" data-ic="users"></span>'+
        '<div class="li-main"><div class="li-title">'+m.title+'</div>'+
        '<div class="li-sub">'+(m.status==="failed"?m.error:(m.status==="working"?m.progress:(m.status==="done"?m.model+" ile yazıldı":"kayıt: "+m.date.split(",")[1].trim()+" · wav diskte")))+"</div></div>"+
        '<div class="li-side"><div class="li-meta">'+m.date.split(",")[0]+" · "+m.len+"</div>"+chipFor(m)+"</div>";
      row.addEventListener("click",()=>{selected=m.id;render();});
      row.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();selected=m.id;render();}});
      list.appendChild(row);
    });
    document.getElementById("list-count").textContent=MEETINGS.length+" toplantı";
    DK.inject(list);
  }
  function render(){
    renderList();
    const m=MEETINGS.find(x=>x.id===selected);
    const status=document.getElementById("viewer-status");
    const doc=document.getElementById("viewer-doc");
    const write=document.getElementById("write-min");
    const del=document.getElementById("delete-min");
    const copy=document.getElementById("copy-min");
    if(!m){
      status.innerHTML="";
      doc.innerHTML='<div class="empty"><span class="empty-ic" data-ic="users"></span><div class="empty-t">Henüz toplantı yok</div><div class="empty-d">Tepsi menüsünden "Toplantı kaydet" ile başlayın; kayıt bittiğinde tutanak kendiliğinden yazılır ve burada listelenir.</div><a class="btn btn-secondary" href="meeting.html">Toplantı ayarları</a></div>';
      DK.inject(doc);
      write.disabled=true;write.textContent="Yaz";write.title="";
      del.disabled=true;copy.disabled=true;
      return;
    }
    status.innerHTML=m.banner||"";
    DK.inject(status);
    doc.innerHTML=m.doc;
    write.disabled=false;
    del.disabled=(m.status==="working");
    copy.disabled=false;
    if(m.status==="done"){write.textContent="Yazıldı";write.disabled=true;write.title="Bu toplantı zaten yazıldı.";}
    else if(m.status==="working"){write.innerHTML='<span class="spin sm"></span> Yazılıyor…';write.disabled=true;}
    else if(m.status==="failed"){write.textContent="Yeniden yaz";write.title="Transkript hazır; yazım transkriptten devam eder.";}
    else{write.textContent="Yaz";write.title="Kaydı transkribe et ve tutanağı yaz.";}
  }
  document.getElementById("write-min").addEventListener("click",()=>{
    const m=MEETINGS.find(x=>x.id===selected);
    if(!m||m.status==="done"||m.status==="working")return;
    m.status="working";m.progress="Transkript hazırlanıyor…";
    render();
    DK.toast("Yazım başladı: "+m.title);
    setTimeout(()=>{m.progress="Temizleniyor 1/2…";render();},1600);
    setTimeout(()=>{m.status="done";m.model=m.model||"google/gemini-3.5-flash";render();DK.toast("Tutanak yazıldı: "+m.title);},4200);
  });
  document.getElementById("delete-min").addEventListener("click",()=>{
    const m=MEETINGS.find(x=>x.id===selected);
    if(!m)return;
    if(m.status==="working"){DK.toast("Bu toplantı şu anda yazılıyor; silinemez.","warn");return;}
    document.getElementById("dlg-dm-body").innerHTML="<b>"+m.title+"</b> toplantısı, tutanağı ve ses kaydı silinir. Bu işlem geri alınamaz.";
    DK.openDialog("dlg-delete-meeting");
  });
  document.getElementById("delete-confirm").addEventListener("click",()=>{
    const i=MEETINGS.findIndex(x=>x.id===selected);
    const name=MEETINGS[i].title;
    MEETINGS.splice(i,1);
    selected=MEETINGS.length?MEETINGS[Math.max(0,i-1)].id:null;
    DK.closeDialog("dlg-delete-meeting");
    render();
    DK.toast("Silindi: "+name,"warn");
  });
  document.getElementById("copy-min").addEventListener("click",()=>DK.toast("Tutanak panoya kopyalandı."));
  document.getElementById("open-folder").addEventListener("click",()=>DK.toast("Klasör açılıyor: …\\dikte\\meetings"));
  document.getElementById("open-folder-2").addEventListener("click",()=>DK.toast("Klasör açılıyor: …\\dikte\\meetings"));
  document.getElementById("reload").addEventListener("click",e=>{
    const btn=e.currentTarget;
    btn.disabled=true;btn.innerHTML='<span class="spin sm"></span> Yeniden yükleniyor…';
    setTimeout(()=>{
      btn.disabled=false;btn.innerHTML='Yeniden yükle';
      render();DK.toast("Tutanak listesi yenilendi.");
    },900);
  });
  render();
})();
</script>
</body>
</html>
