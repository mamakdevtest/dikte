<script src="assets/dikte.js"></script>
<script>
(function(){
  var frame=document.getElementById('screen-frame'), loading=document.getElementById('frame-loading'), frameError=document.getElementById('frame-error'), retry=document.getElementById('retry-frame'), searchEmpty=document.getElementById('search-empty'), title=document.getElementById('work-title'), nav=document.getElementById('module-nav'), links=[].slice.call(nav.querySelectorAll('[data-screen]')), current='general', reduced=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var screens=links.map(function(a){return a.dataset.screen;});
  function setActive(key){var link=links.find(function(a){return a.dataset.screen===key;});if(!link)return;current=key;links.forEach(function(a){a.classList.toggle('is-active',a===link);a.setAttribute('aria-current',a===link?'page':'false');});title.textContent=link.dataset.label;document.title='Dikte | '+link.dataset.label;try{localStorage.setItem('dikte.shell.screen',key);}catch(e){} }
  function syncFrameTheme(){try{var doc=frame.contentDocument;if(doc)doc.documentElement.setAttribute('data-theme',window.DK&&window.DK.getTheme?window.DK.getTheme():'dark');}catch(e){}}
  function injectFrame(){try{var doc=frame.contentDocument;if(!doc)return;var style=doc.createElement('style');style.textContent='.titlebar,.sidebar{display:none!important}.app{display:block!important;height:100vh!important;overflow:hidden!important}.main{height:100vh!important;overflow-y:auto!important}.page{max-width:1100px!important}';doc.head.appendChild(style);doc.documentElement.dataset.embedded='true';syncFrameTheme();}catch(e){}}
  function navigate(key,write){var link=links.find(function(a){return a.dataset.screen===key;});if(!link)return;setActive(key);frameError.classList.remove('is-visible');loading.classList.add('is-visible');if(!reduced)frame.classList.add('is-switching');setTimeout(function(){frame.src=link.getAttribute('href');if(write)history.pushState({screen:key},'', '#'+key);},reduced?0:100);}
  frame.addEventListener('load',function(){injectFrame();frameError.classList.remove('is-visible');setTimeout(function(){loading.classList.remove('is-visible');frame.classList.remove('is-switching');},reduced?0:90);});
  frame.addEventListener('error',function(){loading.classList.remove('is-visible');frame.classList.remove('is-switching');frameError.classList.add('is-visible');});
  document.addEventListener('dk-theme-change',syncFrameTheme);
  links.forEach(function(a){a.addEventListener('click',function(e){e.preventDefault();navigate(a.dataset.screen,true);});});
  function step(dir){var i=screens.indexOf(current);navigate(screens[(i+dir+screens.length)%screens.length],true);}
  document.getElementById('back-screen').addEventListener('click',function(){step(-1)});document.getElementById('next-screen').addEventListener('click',function(){step(1)});document.getElementById('reload-screen').addEventListener('click',function(){frameError.classList.remove('is-visible');loading.classList.add('is-visible');try{frame.contentWindow.location.reload();}catch(e){navigate(current,false);}});retry.addEventListener('click',function(){navigate(current,false);});document.getElementById('open-home').addEventListener('click',function(){navigate('general',true)});
  document.getElementById('module-search').addEventListener('input',function(e){var q=e.target.value.trim().toLowerCase(),visible=0;links.forEach(function(a){var match=!q||a.dataset.label.toLowerCase().includes(q);a.hidden=!match;if(match)visible+=1;});searchEmpty.hidden=visible>0;});
  window.addEventListener('popstate',function(){var key=(location.hash||'#general').slice(1);navigate(screens.includes(key)?key:'general',false);});
  document.addEventListener('keydown',function(e){if(e.altKey&&e.key==='ArrowRight'){e.preventDefault();step(1)}else if(e.altKey&&e.key==='ArrowLeft'){e.preventDefault();step(-1)}else if(e.ctrlKey&&e.key.toLowerCase()==='k'){e.preventDefault();document.getElementById('module-search').focus();}});
  var saved='general';try{saved=location.hash?location.hash.slice(1):(localStorage.getItem('dikte.shell.screen')||'general');}catch(e){}navigate(screens.includes(saved)?saved:'general',false);
})();
</script>
</body>
</html>
