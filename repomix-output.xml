        if edit_level >= 4:
            length = ("Önemli olguları ve niyeti koru. Sınırlı kısaltmaya izin verilir ama esas içeriği özetleyerek yok etme.")
        if edit_level == 5:
            length += " Seviye 5 olsa bile agresif özetleme yasaktır — yalnızca sınırlı kısaltma."
