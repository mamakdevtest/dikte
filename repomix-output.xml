    busy:{
      tip:"Dikte: Claude düşünüyor",dot:"busy",
      items:[
        {ic:"mic",label:"Kaydı başlat",kbd:"Ctrl+Space"},
        {ic:"terminal",label:"Claude'a sor",off:true},
        {ic:"refresh",label:"Yeni bir konuşma başlat",off:true},
