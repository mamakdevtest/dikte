def cmd_devices(opts):
    conf = cfg.Config()
    default = audio.default_monitor()
    mics = [{"name": name, "description": desc,
             "chosen": name == conf["mic_target"]}
            for name, desc in audio.list_sources()]
    monitors = [{"name": name, "description": desc,
