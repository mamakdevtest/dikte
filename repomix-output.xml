<file path="design/Dikte-Yeniden-Tasarım-Prototipi/index.html">
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<title>Dikte | Masaüstü uygulaması</title>
<link rel="icon" type="image/png" href="dikte.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/dikte.css">
<style>
body{overflow:hidden}
.shell{height:100vh;display:grid;grid-template-columns:250px minmax(0,1fr);grid-template-rows:46px minmax(0,1fr);grid-template-areas:"top top" "side work";background:var(--canvas)}
.shell-top{grid-area:top;display:flex;align-items:center;gap:12px;padding:0 16px;border-bottom:1px solid var(--border);background:var(--surface)}
.shell-mark{width:24px;height:24px;display:grid;place-items:center;overflow:hidden;border-radius:6px;background:var(--fg)}.shell-brand-icon{display:block;width:24px;height:24px;object-fit:cover}
.shell-title{font-size:13px;font-weight:600}.shell-context{font-size:11.5px;color:var(--fg-3);padding-left:12px;border-left:1px solid var(--border)}
.shell-actions{margin-left:auto;display:flex;align-items:center;gap:8px}.shell-status{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--fg-2);padding-right:8px}.shell-status .dot{width:6px;height:6px}
.shell-icon{width:36px;height:36px;display:grid;place-items:center;border-radius:6px;color:var(--fg-2);transition:background .12s ease,color .12s ease,transform .08s ease}.shell-icon:hover{background:var(--surface-2);color:var(--fg)}.shell-icon:active{transform:translateY(1px);background:var(--border)}
.shell-icon:focus-visible,.shell-nav-item:focus-visible,.shell-search:focus-visible{outline:2px solid var(--sage-dark);outline-offset:2px}
