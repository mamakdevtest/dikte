<script>
(function(){
  document.querySelectorAll("[data-reveal]").forEach(b=>{
    b.addEventListener("click",()=>{
      const inp=b.parentElement.querySelector("input");
      inp.type=inp.type==="password"?"text":"password";
    });
  });
  document.querySelectorAll("[data-menu]").forEach(btn=>{
    btn.addEventListener("click",e=>{
      e.stopPropagation();
      const m=document.getElementById(btn.dataset.menu);
      document.querySelectorAll(".menu").forEach(x=>{if(x!==m)x.hidden=true;});
      m.hidden=!m.hidden;
    });
  });
  document.addEventListener("click",e=>{
    if(!e.target.closest(".menu-anchor"))document.querySelectorAll(".menu").forEach(m=>m.hidden=true);
  });
  document.querySelectorAll("[data-busy-demo]").forEach(b=>{
    b.addEventListener("click",()=>{
      const old=b.textContent;
      b.disabled=true;b.textContent=b.dataset.busyDemo;
      setTimeout(()=>{b.disabled=false;b.textContent=old;DK.toast("Tamamlandı.");},1000);
    });
  });
  const dlModel=document.getElementById("dl-model");
  const dlRow=document.getElementById("row-download");
  const dlBar=document.getElementById("dl-bar");
  const dlSize=document.getElementById("dl-size");
  let dlTimer=null,dlPct=42;
  dlModel.addEventListener("click",()=>{
    dlRow.hidden=false;dlPct=42;
    clearInterval(dlTimer);
    dlTimer=setInterval(()=>{
      dlPct=Math.min(100,dlPct+1);
      dlBar.style.width=dlPct+"%";
      const gb=(2.9*dlPct/100).toFixed(2).replace(".",",");
      dlSize.textContent=gb+" / 2,90 GB · %"+dlPct;
      if(dlPct>=100){
        clearInterval(dlTimer);
        dlRow.hidden=true;
        DK.toast("ggml-large-v3.bin indirildi.");
        const sel=document.getElementById("whisper-model");
        sel.options[3].textContent="ggml-large-v3.bin · indirildi";
      }
    },120);
  });
  document.getElementById("dl-stop").addEventListener("click",()=>{
    clearInterval(dlTimer);dlRow.hidden=true;DK.toast("İndirme durduruldu.","warn");
  });
  const npAdd=document.getElementById("np-add");
  npAdd.addEventListener("click",()=>{
    const name=document.getElementById("np-name");
    const url=document.getElementById("np-url");
    const nameErr=document.getElementById("np-name-err");
    const urlErr=document.getElementById("np-url-err");
    let ok=true;
    nameErr.hidden=name.value.trim().length>0;if(nameErr.hidden===false)ok=false;
    const uOk=/^https:\/\/.+\..+/.test(url.value.trim());
    urlErr.hidden=uOk;if(!uOk)ok=false;
    name.classList.toggle("is-invalid",nameErr.hidden===false);
    url.classList.toggle("is-invalid",!uOk);
    if(!ok)return;
    const list=document.getElementById("prov-list");
    const div=document.createElement("div");
    div.className="prov";div.setAttribute("data-od-id","provider-user-new");
    div.innerHTML='<div class="prov-name"><b></b><span class="chip chip-tan">Ağ geçidi</span></b><span class="mono"></span></div><div></div><div class="prov-status"><span class="dot dot-err"></span>Anahtar gerekli — Anahtarlar… ile ekleyin</div><div class="prov-actions"><button class="btn btn-secondary btn-sm" data-dialog-open="dlg-keys"><span data-ic="key"></span>Anahtarlar…</button><button class="btn btn-secondary btn-sm" data-test data-test-status="#st-new" data-test-ok="Anahtar çalışıyor.">Sına</button></div>';
    div.querySelector("b").textContent=name.value.trim();
    div.querySelector(".prov-name .mono").textContent=url.value.trim().replace(/^https?:\/\//,"");
    list.appendChild(div);
    DK.inject();
    DK.closeDialog("dlg-add");
    DK.toast("Sağlayıcı eklendi: "+name.value.trim());
    name.value="";url.value="";
  });
  document.getElementById("nk-save").addEventListener("click",()=>{
    DK.closeDialog("dlg-key-add");
    DK.toast("Anahtar kaydedildi ve maskeleyildi.");
  });
  document.getElementById("nk-remove").addEventListener("click",()=>{
    DK.closeDialog("dlg-key-remove");
    DK.toast("Anahtar kaldırıldı.","warn");
  });
  document.querySelectorAll("[data-set-active]").forEach(b=>b.addEventListener("click",()=>{
    DK.toast("Yedek anahtar etkin yapıldı.");
  }));
  document.getElementById("rn-save").addEventListener("click",()=>DK.toast("Sağlayıcı yeniden adlandırıldı."));
  document.getElementById("url-save").addEventListener("click",()=>DK.toast("Temel URL güncellendi."));
  document.getElementById("prm-remove").addEventListener("click",()=>{
    DK.closeDialog("dlg-provider-remove");
    DK.toast("OpenRouter kaldırıldı.","warn");
  });
  document.getElementById("test-all").addEventListener("click",()=>{
    const btn=document.getElementById("test-all");
    btn.disabled=true;btn.innerHTML='<span class="spin sm"></span> Sınanıyor…';
    setTimeout(()=>{
      btn.disabled=false;btn.innerHTML='Bağlantıları sına';
      DK.toast("6 sağlayıcı çalışıyor · 1 sorun (agy kurulu değil)","warn");
    },1400);
  });
})();
</script>
</body>
</html>
