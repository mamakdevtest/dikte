      renderTray(b.dataset.tray);
    });
  });
  renderTray("idle");
  document.addEventListener('overlay-color-change',function(){var active=document.querySelector('#tray-states .seg-btn.active');if(active)renderTray(active.dataset.tray);});
  menu.addEventListener("click",e=>{
    const it=e.target.closest(".menu-item");
    if(!it||it.classList.contains("disabled"))return;
    DK.toast("Tepsi eylemi: "+it.textContent.trim());
  });
})();
</script>
<script>
(function(){
  var defaults={rec:'#E08A72',ask:'#A8C7B5',busy:'#82B9CE',ok:'#75C59B',warn:'#D8B870',err:'#DF8582'};
  var colors={};try{colors=JSON.parse(localStorage.getItem('dikte.overlay.colors')||'{}')}catch(e){}
  var root=document.documentElement, fields=[].slice.call(document.querySelectorAll('[data-overlay-color]')),rangeValue=document.getElementById('sound-sensitivity-value');
  function applyColor(key,value){var safe=/^#[0-9a-f]{6}$/i.test(value)?value:defaults[key];colors[key]=safe;root.style.setProperty('--ov-'+key,safe);var field=document.querySelector('[data-overlay-color="'+key+'"]');if(field)field.value=safe;try{localStorage.setItem('dikte.overlay.colors',JSON.stringify(colors))}catch(e){}document.dispatchEvent(new CustomEvent('overlay-color-change'));}
  fields.forEach(function(field){var key=field.dataset.overlayColor;applyColor(key,colors[key]||field.value||defaults[key]);field.addEventListener('input',function(){applyColor(key,field.value);});});
  document.getElementById('reset-overlay-theme').addEventListener('click',function(){Object.keys(defaults).forEach(function(key){applyColor(key,defaults[key]);});DK.toast('Gösterge renkleri varsayılana döndü.');});
  var meter=document.getElementById('sound-meter'), toggle=document.getElementById('sound-toggle'), state=document.getElementById('sound-state'), range=document.getElementById('sound-sensitivity'), bars=[];for(var i=0;i<24;i++){var bar=document.createElement('i');meter.appendChild(bar);bars.push(bar)}
  function syncRange(){rangeValue.textContent=range.value;}range.addEventListener('input',syncRange);syncRange();
  var running=false,timer=null,audio=null,source=null,analyser=null,data=null,stream=null;
  function paint(level){var gain=parseInt(range.value,10)/62;bars.forEach(function(bar,i){var shape=.18+.82*Math.abs(Math.sin(i*.74+Date.now()/180));var h=Math.max(5,Math.min(50,Math.round(5+level*gain*shape*42)));bar.style.height=h+'px';});document.querySelectorAll('.ov-wave i').forEach(function(bar,i){var h=Math.max(3,Math.min(24,Math.round(3+level*gain*(.25+.75*Math.abs(Math.sin(i*.9+Date.now()/150)))*22)));bar.style.setProperty('--h',h+'px');});}
  function stopAudio(){if(timer){cancelAnimationFrame(timer);timer=null}if(source){source.disconnect();source=null}if(stream){stream.getTracks().forEach(function(track){track.stop()});stream=null}if(audio){audio.close();audio=null}running=false;toggle.innerHTML='<span data-ic="play"></span>Ses tepkisini başlat';state.innerHTML='<span class="dot dot-idle"></span>Kapalı';DK.inject(toggle);}
  function simulate(){if(!running)return;paint(.25+Math.random()*.68);timer=requestAnimationFrame(simulate);}
  function live(){if(!running)return;if(analyser){analyser.getByteTimeDomainData(data);var sum=0;for(var i=0;i<data.length;i++){var x=(data[i]-128)/128;sum+=x*x}paint(Math.min(1,Math.sqrt(sum/data.length)*3.6));timer=requestAnimationFrame(live)}else simulate();}
  function startAudio(){running=true;toggle.innerHTML='<span data-ic="stop"></span>Ses tepkisini durdur';state.innerHTML='<span class="dot dot-rec"></span>Dinleniyor';DK.inject(toggle);if(navigator.mediaDevices&&navigator.mediaDevices.getUserMedia&&window.AudioContext){navigator.mediaDevices.getUserMedia({audio:true}).then(function(received){stream=received;audio=new (window.AudioContext||window.webkitAudioContext)();source=audio.createMediaStreamSource(stream);analyser=audio.createAnalyser();analyser.fftSize=256;data=new Uint8Array(analyser.fftSize);source.connect(analyser);state.innerHTML='<span class="dot dot-ok"></span>Mikrofon bağlı';live();}).catch(function(){state.innerHTML='<span class="dot dot-warn"></span>Simülasyon';simulate();});}else{state.innerHTML='<span class="dot dot-warn"></span>Simülasyon';simulate();}}
  toggle.addEventListener('click',function(){if(running)stopAudio();else startAudio();});window.addEventListener('beforeunload',stopAudio);
  paint(.45);
})();
</script>
