<script src="assets/dikte.js"></script>
<script>
(function(){
  const MEETINGS=[
    {id:"m1",title:"Tasarım gözden geçirme",date:"24 Ağustos 2026, 14:30",len:"42 dk",status:"done",model:"google/gemini-3.5-flash",
     banner:"",
     doc:'<h1>Tasarım gözden geçirme</h1><div class="doc-meta">24 Ağustos 2026, 14:30 · 42 dk · google/gemini-3.5-flash ile yazıldı</div>'+
     '<h2>Özet</h2><p>Kayıt akışının üç ekranı elden geçirildi; yapıştırma davranışı ve gösterge köşesi kararlaştırıldı. Ses dosyası kuyruğu bir sonraki sürüme bırakıldı.</p>'+
     '<h2>Kararlar</h2><ul><li>Gösterge varsayılanı sol alt köşe olacak.</li><li>Temizlik varsayılanı açık, düşünme düzeyi kapalı kalacak.</li><li>Yapıştırma tuşu ayarı Genel sayfasında tutulacak.</li></ul>'+
     '<h2>Yapılacaklar</h2><ul><li><b>Deniz:</b> gösterge dalga formunu yeni paletle yeniden çizmek — 27 Ağustos.</li><li><b>Aylin:</b> yapıştırma hata mesajlarını gözden geçirmek — 29 Ağustos.</li><li><b>Atanmadı:</b> SRT çıktısı için örnek dosya hazırlamak.</li></ul>'+
     '<h2>Açık sorular</h2><ul><li>Toplantı kayıtları 4 saatten uzun olursa parçalama stratejisi ne olacak?</li></ul>'+
     '<h2>Dikkat çeken anlar</h2><ul><li><span class="stamp">[12:40]</span> Yapıştırma tuşunun uçbirimde çalışmama durumu tartışıldı.</li></ul>'+
     '<div class="doc-transcript"><h2>Transkript</h2>'+
     '<p class="t-line"><span class="stamp">[00:12]</span><b>Mamak:</b> Göstergeyi sol alta alalım, sağ altta bildirim merkezi var.</p>'+
     '<p class="t-line"><span class="stamp">[03:26]</span><b>Deniz Yıldırım:</b> Dalga formunu tek satır tutalım, toplantıda ikiye bölüyoruz zaten.</p>'+
     '<p class="t-line"><span class="stamp">[18:03]</span><b>Aylin Kaya:</b> Temizlik kapalıyken ham metin gidiyor, kullanıcı şaşırmasın diye küçük bir not koyalım.</p></div>'},
    {id:"m2",title:"Ürün fikirleri — sesli not",date:"24 Ağustos 2026, 09:10",len:"18 dk",status:"recorded",
     banner:'<div class="note note-info"><span data-ic="info"></span><span class="note-body"><b>Kayıt tamamlandı, tutanak bekliyor.</b> Bu kayıt için yazım henüz başlatılmadı; "Yaz" ile şimdi başlatabilirsiniz.</span></div>',
     doc:'<h1>Ürün fikirleri — sesli not</h1><div class="doc-meta">24 Ağustos 2026, 09:10 · 18 dk · kayıt: 20260824-0910.wav</div><p>Henüz bir şey yazılmadı. Kayıt diskte bekliyor; transkripsiyon ve tutanak "Yaz" dediğinizde sırayla çalışır.</p>'},
    {id:"m3",title:"Haftalık planlama",date:"21 Ağustos 2026, 09:00",len:"1 sa 05 dk",status:"working",progress:"Temizleniyor 2/3…",
     banner:'<div class="note note-info"><span data-ic="info"></span><span class="note-body"><b>Tutanak yazılıyor.</b> <span class="working"><span class="spin sm"></span>Temizleniyor 2/3…</span> Bu toplantı silinemez; yazım bitince kendiliğinden listeye düşer.</span></div>',
     doc:'<h1>Haftalık planlama</h1><div class="doc-meta">21 Ağustos 2026, 09:00 · 1 sa 05 dk</div><p class="working"><span class="spin"></span>Transkript temizleniyor; tutanak bundan sonra yazılacak. Bu pencere yazım bitince kendiliğinden dolar.</p>'},
    {id:"m4",title:"Müşteri görüşmesi",date:"19 Ağustos 2026, 15:22",len:"36 dk",status:"failed",error:"Model 600 sn içinde bitmedi",
     banner:'<div class="note note-err"><span data-ic="alert"></span><span class="note-body"><b>Tutanak yazılamadı:</b> Model 600 sn içinde bitmedi. Kayıt saklandı — aşağıdan yeniden deneyebilir ya da Toplantı sayfasından başka bir model seçebilirsiniz.</span></div>',
     doc:'<h1>Müşteri görüşmesi</h1><div class="doc-meta">19 Ağustos 2026, 15:22 · 36 dk · kayıt korundu</div><p>Tutanak yazılamadı; transkript hazır olduğundan yazım transkriptten devam eder, ses bir daha işlenmez.</p>'},
    {id:"m5",title:"Sprint değerlendirmesi",date:"15 Ağustos 2026, 11:00",len:"52 dk",status:"done",model:"gemma-3-4b-it-Q4_K_M",
     banner:"",
     doc:'<h1>Sprint değerlendirmesi</h1><div class="doc-meta">15 Ağustos 2026, 11:00 · 52 dk · gemma-3-4b-it-Q4_K_M ile yazıldı</div>'+
     '<h2>Özet</h2><p>Yayın gecikmesi tek başına dosya transkripsiyonunun parça yüklemesinden kaynaklandı; parça boyutu 24 MB'a sabitlendi.</p>'+
     '<h2>Kararlar</h2><ul><li>Parça üst sınırı 24 MB, parça süresi 10 dakika.</li><li>Zaman damgası kapalıyken parçalar arası örtüşme kaldırıldı.</li></ul>'+
     '<h2>Yapılacaklar</h2><ul><li><b>Deniz:</b> parça birleştirme testlerini genişletmek — 18 Ağustos.</li></ul>'}
  ];
  let selected="m1";
  const list=document.getElementById("meet-list");
  function chipFor(m){
    if(m.status==="done")return '<span class="chip chip-ok"><span data-ic="check" style="width:11px;height:11px"></span>Tutanak hazır</span>';
    if(m.status==="working")return '<span class="chip chip-sage"><span class="spin sm"></span>Yazılıyor…</span>';
    if(m.status==="recorded")return '<span class="chip chip-gray"><span class="dot dot-idle"></span>Yazılmayı bekliyor</span>';
    if(m.status==="failed")return '<span class="chip chip-red"><span data-ic="alert" style="width:11px;height:11px"></span>Başarısız</span>';
    return "";
  }
  function renderList(){
    list.innerHTML="";
    MEETINGS.forEach(m=>{
      const row=document.createElement("div");
      row.className="li-row"+(m.id===selected?" selected":"");
      row.setAttribute("data-od-id","meeting-"+m.id);
      row.setAttribute("role","button");
      row.tabIndex=0;
      row.innerHTML='<span class="li-ic" data-ic="users"></span>'+
        '<div class="li-main"><div class="li-title">'+m.title+'</div>'+
        '<div class="li-sub">'+(m.status==="failed"?m.error:(m.status==="working"?m.progress:(m.status==="done"?m.model+" ile yazıldı":"kayıt: "+m.date.split(",")[1].trim()+" · wav diskte")))+"</div></div>"+
        '<div class="li-side"><div class="li-meta">'+m.date.split(",")[0]+" · "+m.len+"</div>"+chipFor(m)+"</div>";
      row.addEventListener("click",()=>{selected=m.id;render();});
      row.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();selected=m.id;render();}});
      list.appendChild(row);
    });
    document.getElementById("list-count").textContent=MEETINGS.length+" toplantı";
    DK.inject(list);
  }
  function render(){
    renderList();
    const m=MEETINGS.find(x=>x.id===selected);
    const status=document.getElementById("viewer-status");
    const doc=document.getElementById("viewer-doc");
    const write=document.getElementById("write-min");
    const del=document.getElementById("delete-min");
    const copy=document.getElementById("copy-min");
    if(!m){
      status.innerHTML="";
      doc.innerHTML='<div class="empty"><span class="empty-ic" data-ic="users"></span><div class="empty-t">Henüz toplantı yok</div><div class="empty-d">Tepsi menüsünden "Toplantı kaydet" ile başlayın; kayıt bittiğinde tutanak kendiliğinden yazılır ve burada listelenir.</div><a class="btn btn-secondary" href="meeting.html">Toplantı ayarları</a></div>';
      DK.inject(doc);
      write.disabled=true;write.textContent="Yaz";write.title="";
      del.disabled=true;copy.disabled=true;
      return;
    }
    status.innerHTML=m.banner||"";
    DK.inject(status);
    doc.innerHTML=m.doc;
    write.disabled=false;
    del.disabled=(m.status==="working");
    copy.disabled=false;
    if(m.status==="done"){write.textContent="Yazıldı";write.disabled=true;write.title="Bu toplantı zaten yazıldı.";}
    else if(m.status==="working"){write.innerHTML='<span class="spin sm"></span> Yazılıyor…';write.disabled=true;}
    else if(m.status==="failed"){write.textContent="Yeniden yaz";write.title="Transkript hazır; yazım transkriptten devam eder.";}
    else{write.textContent="Yaz";write.title="Kaydı transkribe et ve tutanağı yaz.";}
  }
  document.getElementById("write-min").addEventListener("click",()=>{
    const m=MEETINGS.find(x=>x.id===selected);
    if(!m||m.status==="done"||m.status==="working")return;
    m.status="working";m.progress="Transkript hazırlanıyor…";
    render();
    DK.toast("Yazım başladı: "+m.title);
    setTimeout(()=>{m.progress="Temizleniyor 1/2…";render();},1600);
    setTimeout(()=>{m.status="done";m.model=m.model||"google/gemini-3.5-flash";render();DK.toast("Tutanak yazıldı: "+m.title);},4200);
  });
  document.getElementById("delete-min").addEventListener("click",()=>{
    const m=MEETINGS.find(x=>x.id===selected);
    if(!m)return;
    if(m.status==="working"){DK.toast("Bu toplantı şu anda yazılıyor; silinemez.","warn");return;}
    document.getElementById("dlg-dm-body").innerHTML="<b>"+m.title+"</b> toplantısı, tutanağı ve ses kaydı silinir. Bu işlem geri alınamaz.";
    DK.openDialog("dlg-delete-meeting");
  });
  document.getElementById("delete-confirm").addEventListener("click",()=>{
    const i=MEETINGS.findIndex(x=>x.id===selected);
    const name=MEETINGS[i].title;
    MEETINGS.splice(i,1);
    selected=MEETINGS.length?MEETINGS[Math.max(0,i-1)].id:null;
    DK.closeDialog("dlg-delete-meeting");
    render();
    DK.toast("Silindi: "+name,"warn");
  });
  document.getElementById("copy-min").addEventListener("click",()=>DK.toast("Tutanak panoya kopyalandı."));
  document.getElementById("open-folder").addEventListener("click",()=>DK.toast("Klasör açılıyor: …\\dikte\\meetings"));
  document.getElementById("open-folder-2").addEventListener("click",()=>DK.toast("Klasör açılıyor: …\\dikte\\meetings"));
  document.getElementById("reload").addEventListener("click",e=>{
    const btn=e.currentTarget;
    btn.disabled=true;btn.innerHTML='<span class="spin sm"></span> Yeniden yükleniyor…';
    setTimeout(()=>{
      btn.disabled=false;btn.innerHTML='Yeniden yükle';
      render();DK.toast("Tutanak listesi yenilendi.");
    },900);
  });
  render();
})();
</script>
</body>
</html>
