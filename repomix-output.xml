    def test_an_answer_that_is_not_a_list_is_an_error(self):
        with fake_urlopen({"error": "Invalid username or password."}):
            with self.assertRaises(hub.HubError):
                hub.files("ggml-org/whisper.cpp")


class Repos(DikteTest):
    def setUp(self):
