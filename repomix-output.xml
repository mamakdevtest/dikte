def _run_subprocess(code):
    result = subprocess.run(
        [sys.executable, "-c", code],
        env={**__import__("os").environ, "QT_QPA_PLATFORM": "offscreen"},
        capture_output=True,
        text=True,
        timeout=10,
    )
    return result


