  <main class="main" data-od-id="main">
    <div class="page">
      <header class="page-head" data-od-id="page-head">
        <div>
          <h1 class="page-title">Geçmiş</h1>
          <p class="page-sub">Her dikte ve ajan komutu burada birikir. Kayıtlar bilgisayarınızdan çıkmaz; limit dolduğunda en eskisi atılır.</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-ghost" type="button" id="reload"><span data-ic="refresh"></span>Yeniden yükle</button>
        </div>
      </header>

      <section class="card" data-od-id="history-card">
        <div class="card-f" style="border-top:0;border-bottom:1px solid color-mix(in srgb,var(--border) 62%,transparent)" data-od-id="history-toolbar">
          <span class="search" style="flex:1;max-width:320px"><span data-ic="search"></span><input class="field" id="q" type="search" placeholder="Transkriptlerde ara…" aria-label="Geçmişte ara"></span>
          <span class="seg" id="type-filter" role="group" aria-label="Tür filtresi">
            <button class="seg-btn active" data-f="all">Tümü</button>
            <button class="seg-btn" data-f="dictation">Dikte</button>
            <button class="seg-btn" data-f="ask">Ajan</button>
          </span>
          <span class="spacer"></span>
          <span class="meta" id="sel-count">Seçili yok</span>
          <button class="btn btn-secondary btn-sm" id="copy-sel" disabled><span data-ic="copy"></span>Seçilenleri kopyala</button>
          <button class="btn btn-danger btn-sm" id="del-sel" disabled><span data-ic="trash"></span>Seçilenleri sil</button>
