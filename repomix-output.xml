  const dot=document.getElementById("tray-dot");
  function dotColor(key){return getComputedStyle(document.documentElement).getPropertyValue('--ov-'+key).trim()||DOT_COLORS[key]||'#E08A72';}
  function renderTray(key){
    const st=STATES[key];
    tip.textContent=st.tip;
    if(st.dot){dot.hidden=false;dot.style.background=dotColor(st.dot);}
    else dot.hidden=true;
    menu.innerHTML=st.items.map(it=>{
      if(it.sep)return '<div class="menu-sep"></div>';
      return '<button class="menu-item'+(it.off?" disabled":"")+'" type="button"'+(it.off?' aria-disabled="true"':"")+'><span data-ic="'+it.ic+'"></span>'+it.label+(it.kbd?'<span class="menu-kbd">'+it.kbd+"</span>":"")+"</button>";
