        turns = meeting.merge_turns([
            seg(0.0, 1.0, "...", "mine"),
            seg(2.0, 3.0, "hello", "theirs"),
        ])
        self.assertEqual(len(turns), 1)

    def test_nothing_was_said_at_all(self):
        self.assertEqual(meeting.merge_turns([]), [])


